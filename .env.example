# The settings glamlink.net needs. Copy to .env.local, fill in the empty values, and rebuild (npm run build): the
# NEXT_PUBLIC_ ones are built into the pages, so anyone can read them; never put a secret in one.
#
# test.glamlink.net instead: NEXT_PUBLIC_SITE_URL=https://test.glamlink.net, SITE_INDEXING=off, and no GTM or AdSense
# IDs. Local development: NEXT_PUBLIC_SITE_URL=http://localhost:3000 (the API allows only port 3000 locally).

NEXT_PUBLIC_SITE_URL=https://glamlink.net
NEXT_PUBLIC_API_URL=https://api.glamlink.net/api/v1
# on: search engines may index the site
SITE_INDEXING=on

# The API's WEBSITE_REFRESH_SECRET, the same value: the API tells the site what changed, and pages update in seconds
REVALIDATE_SECRET=

# Cloudflare > Turnstile > the Glamlink widget > Site key (the API has its secret key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Cloud > APIs & Services > Credentials. The browser key: Maps JavaScript API and Places API, restricted to
# the site's addresses (https://glamlink.net/*, https://www.glamlink.net/*). Address autocomplete in the card form.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: the /directory page's Google map. A key with only the Maps Static API, and its URL signing secret
# (Google Cloud > Maps Static API > Credentials). Without them the page shows its own map.
GOOGLE_MAPS_STATIC_KEY=
GOOGLE_MAPS_SIGNING_SECRET=

# Google Tag Manager container ID (GTM-…) and AdSense publisher ID (ca-pub-…): glamlink.net only
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Read by the code but left unset: NEXT_PUBLIC_STRIPE_PUBLIC_KEY (checkout takes the key the API reports) and
# NEXT_PUBLIC_YOUTUBE_API_KEY (the API serves the podcast's episodes). The README lists every variable.
