# Glamlink web — environment variables
#
# Copy this file to `.env.local` for local development, or set these on the
# server / hosting platform for staging and production.
#
# Variables starting with NEXT_PUBLIC_ are inlined into the browser bundle at
# BUILD time: anyone can read them, and changing one requires a rebuild. Never
# put a secret in a NEXT_PUBLIC_ variable. The others (SITE_INDEXING,
# REVALIDATE_SECRET) stay on the server.

# ── Required ─────────────────────────────────────────────────────────────────
# `next build` fails if either of these is missing.

# Public origin of this site, without a trailing slash. Used for canonical URLs,
# Open Graph tags, structured data, the sitemap and robots.txt.
#   production: https://glamlink.net
#   local:      http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL. A trailing slash is optional.
# Its origin also serves uploaded images (/images/...), which next/image is
# allowed to load. The API must list this site's origin in its ACCESSDOMAINS.
#   new backend (from the switch): https://api.glamlink.net/api/v1
#   local backend (glamlink-backend, port 5050): http://localhost:5050/api/v1
NEXT_PUBLIC_API_URL=https://api.glamlink.net/api/v1

# ── Search engines ───────────────────────────────────────────────────────────

# Whether search engines may index this deployment: on | off. Read at build
# time (rebuild after changing it). Off: every page sends noindex/nofollow (meta
# tag and X-Robots-Tag header), robots.txt disallows everything, the sitemap is
# empty. Unset: only a build whose NEXT_PUBLIC_SITE_URL is glamlink.net is
# indexed, so test.glamlink.net and localhost stay out of search engines anyway.
#   production: on (or unset)    test.glamlink.net: off (or unset)
SITE_INDEXING=

# ── Cache refresh ────────────────────────────────────────────────────────────

# Shared secret for the API's cache-refresh hook (POST /api/revalidate): after
# each change made through the API, it tells the site which data changed, so
# pages update within seconds while staying cached for an hour otherwise.
# Generate a long random value (e.g. `openssl rand -hex 32`) and give the API
# the same one: WEBSITE_REFRESH_SECRET=<this>, and
# WEBSITE_REFRESH_URL=<NEXT_PUBLIC_SITE_URL>/api/revalidate. Unset: the hook
# answers 503 and pages refresh on their hourly expiry only.
REVALIDATE_SECRET=

# ── Third-party keys (features degrade without them) ─────────────────────────
# These are browser keys. Restrict each one in its provider's console to the
# site's domains (HTTP referrer) and to only the APIs it needs.

# Stripe publishable key. Optional: checkout loads the key the API reports
# (GET /payment/stripe/stripe-key), so it always matches the API's mode; this is
# only a fallback if that call fails. Same account and mode as the API if set.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# Google Maps JavaScript + Places API key: address autocomplete in the card
# form and provider photos on /journal/directory. The /directory page's Google
# listings come through the API and need no key here.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# The /directory hero's Google map (Maps Static API, one billed load per page
# view). Optional: without it the page shows its own Las Vegas map. Turn on only
# the Maps Static API for this key and restrict it to the site's addresses.
GOOGLE_MAPS_STATIC_KEY=
# The Maps Static API's "URL signing secret" (Google Cloud > Maps Static API >
# Credentials). Optional, recommended: the map's address is signed, and with the
# key's unsigned requests quota at 0 a copied key draws nothing. Server only.
GOOGLE_MAPS_SIGNING_SECRET=

# Cloudflare Turnstile site key for the sign-up captcha. Required in production:
# the API refuses sign-ups without a token (CAPTCHA_REQUIRED). It pairs with the
# API's TURNSTILE_SECRET_KEY. Testing: Cloudflare's always-pass site key
# 1x00000000000000000000AA (with the API's test secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# YouTube Data API v3 key: only a fallback for the podcast page while the API
# has no videos. The API now imports each series' playlist with its own key
# (GET /videos); once it does, leave this empty so no key ships to browsers.
NEXT_PUBLIC_YOUTUBE_API_KEY=

# ── Analytics and ads (production only) ──────────────────────────────────────
# Leave empty in development and staging so test traffic is not tracked and
# ads are not served off the live domain.

# Google Tag Manager container ID (GTM-XXXXXXX).
NEXT_PUBLIC_GTM_ID=

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ── Test site (test.glamlink.net) ────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://test.glamlink.net
# NEXT_PUBLIC_API_URL=https://api.glamlink.net/api/v1
# SITE_INDEXING=off
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<the widget's site key; test.glamlink.net in its hostnames>
# Leave NEXT_PUBLIC_GTM_ID and NEXT_PUBLIC_ADSENSE_CLIENT_ID empty.
# The API needs https://test.glamlink.net in ACCESSDOMAINS, and WEBSITE_URL set
# to it while testing, so email links open the test site.
